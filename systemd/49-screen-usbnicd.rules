// 安装到 /etc/polkit-1/rules.d/49-screen-usbnicd.rules（需要 sudo）
//
// 目的：让本机用户 xzh-wuyan 不输密码就能从门户对 usbnicd.service 做
// start / stop / restart（门户跑在 systemd 用户单元里，没有交互式提权窗口）。
// 这是唯一被放开的单元与动作；其它 systemd 操作仍然需要认证。
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units") {
    return;
  }
  if (subject.user !== "xzh-wuyan") {
    return;
  }
  if (action.lookup("unit") !== "usbnicd.service") {
    return;
  }
  var verb = action.lookup("verb");
  if (["start", "stop", "restart", "try-restart"].indexOf(verb) < 0) {
    return;
  }
  return polkit.Result.YES;
});
